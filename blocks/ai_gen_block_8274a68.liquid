 {% doc %}
  @prompt
    Hey, we have testimonials in blogs and News and we have testimonials. Okay, so we want to show test just testimonials in a card a responsive card and Just card there there should be nothing in it. Just the titles and The description that have the card description that have okay Testimony wanna we want a popular just testimonials on the section Okay, so create a great section there where users can see just image title and The blog Text okay, nothing else. I don't want you to add any buttons or any Icon something like that. You have to create really amazing section
{% enddoc %}
{%- assign ai_source = section -%}
{%- if block -%}
  {%- assign ai_source = block -%}
{%- endif -%}
{%- assign ai_settings = ai_source.settings -%}
{%- assign ai_gen_id = ai_source.id | replace: '_', '' | downcase -%}

{% style %}
  .ai-testimonials-section-{{ ai_gen_id }} {
    padding: {{ ai_settings.section_padding_top }}px 0 {{ ai_settings.section_padding_bottom }}px;
    background-color: {{ ai_settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ ai_settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    text-align: {{ ai_settings.heading_alignment }};
    margin-bottom: {{ ai_settings.heading_spacing }}px;
    color: {{ ai_settings.heading_color }};
    font-size: {{ ai_settings.heading_size }}px;
  }

  .ai-testimonials-scroller-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
    {% if ai_settings.enable_scroll_animation %}
      animation: scroll-{{ ai_gen_id }} {{ ai_settings.animation_duration }}s linear infinite;
      will-change: transform;
    {% endif %}
  }

  @keyframes scroll-{{ ai_gen_id }} {
    to {
      transform: translate(calc(-50% - {{ ai_settings.card_spacing | divided_by: 2 }}px));
    }
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ ai_settings.card_background }};
    border-radius: {{ ai_settings.card_border_radius }}px;
    padding: {{ ai_settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ ai_settings.content_spacing }}px;
    {% if ai_settings.show_card_shadow %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    {% if ai_settings.show_card_border %}
      border: 1px solid {{ ai_settings.card_border_color }};
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    margin-right: {{ ai_settings.card_spacing }}px;
    width: {{ ai_settings.card_width }}px;
    flex-shrink: 0;
    content-visibility: auto;
    contain: content;
    contain-intrinsic-size: 400px 320px;
  }

  {% if ai_settings.enable_hover_effect %}
    .ai-testimonial-card-{{ ai_gen_id }}:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }
  {% endif %}

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ ai_settings.image_border_radius }}px;
    aspect-ratio: {{ ai_settings.image_aspect_ratio }};
  }

  .ai-testimonial-new-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    padding: 5px 10px;
    border-radius: 999px;
    background: #15803d;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-transform: uppercase;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.18);
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ ai_settings.text_spacing }}px;
  }

  .ai-testimonial-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-size: {{ ai_settings.title_size }}px;
    color: {{ ai_settings.title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} {
    font-size: {{ ai_settings.excerpt_size }}px;
    color: {{ ai_settings.excerpt_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b {
    font-weight: 700;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} strong em,
  .ai-testimonial-excerpt-{{ ai_gen_id }} strong i,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b em,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b i,
  .ai-testimonial-excerpt-{{ ai_gen_id }} em strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} em b,
  .ai-testimonial-excerpt-{{ ai_gen_id }} i strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} i b {
    color: red;
    display: block;
    font-weight: 700;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {

  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-section-{{ ai_gen_id }} {
      padding: {{ ai_settings.section_padding_top | times: 0.7 }}px 0 {{ ai_settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ ai_settings.heading_size | times: 0.8 }}px;
      margin-bottom: {{ ai_settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ ai_settings.card_padding | times: 0.8 }}px;
    }

    .ai-testimonial-title-{{ ai_gen_id }} {
      font-size: {{ ai_settings.title_size | times: 0.9 }}px;
    }

    .ai-testimonial-excerpt-{{ ai_gen_id }} {
      font-size: {{ ai_settings.excerpt_size | times: 0.9 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      animation: none !important;
    }
  }
{% endstyle %}

<div class="ai-testimonials-section-{{ ai_gen_id }}"{% if block %} {{ block.shopify_attributes }}{% endif %}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if ai_settings.heading != blank %}
      <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ ai_settings.heading }}</h2>
    {% endif %}

    <div class="ai-testimonials-scroller-{{ ai_gen_id }}">
      <div class="ai-testimonials-grid-{{ ai_gen_id }}">
        {% if ai_settings.blog != blank %}
          {% assign articles = ai_settings.blog.articles %}
          {% assign article_limit = ai_settings.articles_to_show %}
          {%- assign sizes_attr = "(max-width: 749px) 70vw, (max-width: 1024px) 45vw, " | append: ai_settings.card_width | append: "px" -%}
          {%- assign widths_attr = "240, 320, 400" -%}
          {% capture testimonial_cards %}
            {% for article in articles limit: article_limit %}
              {%- assign loading_mode = 'lazy' -%}
              {%- if forloop.index <= 2 -%}
                {%- assign loading_mode = 'eager' -%}
              {%- endif -%}
              <div class="ai-testimonial-card-{{ ai_gen_id }}">
                <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                  {%- if forloop.index <= 8 -%}
                    <span class="ai-testimonial-new-badge-{{ ai_gen_id }}">New</span>
                  {%- endif -%}
                  {% if article.image %}
                    {%- assign image_class = "ai-testimonial-image-" | append: ai_gen_id -%}
                    {{ article.image | image_url: width: 400 | image_tag: class: image_class, loading: loading_mode, decoding: "async", sizes: sizes_attr, widths: widths_attr, alt: article.image.alt | escape }}
                  {% else %}
                    <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-testimonial-content-{{ ai_gen_id }}">
                  {% if ai_settings.show_rating %}
                    <div class="ai-testimonial-rating-{{ ai_gen_id }}">
                      {% for i in (1..ai_settings.rating_value) %}
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="#fdd835" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% if ai_settings.show_title and article.title != blank %}
                    <h3 class="ai-testimonial-title-{{ ai_gen_id }}">{{ article.title }}</h3>
                  {% endif %}

                  {% if ai_settings.show_excerpt %}
                    <div class="ai-testimonial-excerpt-{{ ai_gen_id }}">
                      {%- if article.excerpt != blank -%}
                        {{ article.excerpt | strip_html | truncate: ai_settings.excerpt_length }}
                      {%- else -%}
                        {{ article.content | strip_html | truncate: ai_settings.excerpt_length }}
                      {%- endif -%}
                    </div>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% endcapture %}

          {{ testimonial_cards }}
          {% if ai_settings.enable_scroll_animation %}
            {{ testimonial_cards }}
          {% endif %}
        {% else %}
          {% capture testimonial_placeholders %}
            {% for i in (1..6) %}
              <div class="ai-testimonial-card-{{ ai_gen_id }}">
                <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                  <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                </div>

                <div class="ai-testimonial-content-{{ ai_gen_id }}">
                  {% if ai_settings.show_rating %}
                    <div class="ai-testimonial-rating-{{ ai_gen_id }}">
                      {% for i in (1..ai_settings.rating_value) %}
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="#fdd835" xmlns="http://www.w3.org/2000/svg">
                          <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/>
                        </svg>
                      {% endfor %}
                    </div>
                  {% endif %}
                  <h3 class="ai-testimonial-title-{{ ai_gen_id }}">Testimonial Title</h3>
                  <div class="ai-testimonial-excerpt-{{ ai_gen_id }}">
                    <p>This is a sample testimonial text. Select a blog to display your testimonials.</p>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endcapture %}

          {{ testimonial_placeholders }}
          {% if ai_settings.enable_scroll_animation %}
            {{ testimonial_placeholders }}
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

