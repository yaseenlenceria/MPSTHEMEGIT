          </product-form>
        </div>
      </div>
    </div>
  {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- if show_bar_end_mirrors -%}
  {%- if upsell_count < upsell_limit -%}
  {%- liquid
    assign upsell_product = all_products['puig_mirrors_ht4_bar_end_in_black_silver_various_models-product-17691']
    if upsell_product == blank
      assign upsell_product = all_products['puig_mirrors_tracker_bar_end_mirrors_in_black_silver_various_models-product-19232']
    endif

    if upsell_product == blank
      assign catalog = collections.all
      if catalog == nil or catalog.products == blank
        assign catalog = collections['all']
      endif

      if catalog and catalog.products != blank
        for candidate in catalog.products
          assign candidate_vendor = candidate.vendor | downcase
          assign candidate_tags = candidate.tags | join: ',' | downcase
          assign candidate_title = candidate.title | downcase
          assign candidate_type = candidate.type | downcase

          if candidate_vendor == 'puig' and candidate_type contains 'mirror' and candidate_title contains 'bar end' and candidate_tags contains 'universal'
            assign upsell_product = candidate
            break
          endif
        endfor
      endif
    endif
  -%}

  {%- if upsell_product and upsell_product != blank -%}
    {%- assign upsell_count = upsell_count | plus: 1 -%}
    {%- assign upsell_alt = upsell_product.title | escape -%}
    <div class="cart-upsell panel mt-6">
      <h3 class="h6 mb-3">Complete your control upgrade with Puig Bar End Mirrors</h3>
      <div class="cart-upsell__content flex items-center gap-x-theme">
        <a class="cart-upsell__media block" href="{{ upsell_product.url }}">
          {%- if upsell_product.featured_image -%}
            {{ upsell_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: upsell_alt }}
          {%- endif -%}
        </a>
        <div class="cart-upsell__details">
          <a class="link block mb-1" href="{{ upsell_product.url }}">{{ upsell_product.title | escape }}</a>
          <p class="text-sm mb-2">{{ upsell_product.price | money }}</p>
          <product-form class="block">
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}">
