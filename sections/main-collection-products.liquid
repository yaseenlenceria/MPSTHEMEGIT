      "label": "Enable filtering",
      "info": "[Customize filters](https://help.shopify.com/manual/online-store/search-and-discovery/filters)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "filters_open_lg",
      "label": "Open filters by default on large screens",
