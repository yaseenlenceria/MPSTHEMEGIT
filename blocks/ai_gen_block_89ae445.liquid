{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonials-intro-{{ ai_gen_id }} {
    text-align: {{ block.settings.intro_alignment }};
    margin-bottom: 30px;
  }

  .ai-testimonials-intro-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.intro_text_size }}px;
    color: {{ block.settings.intro_text_color }};
    line-height: 1.6;
    margin: 0 0 20px;
  }

  .ai-testimonials-cta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: {{ block.settings.intro_alignment }};
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-testimonials-cta-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.cta_text_size }}px;
    color: {{ block.settings.cta_text_color }};
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonials-cta-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: {{ block.settings.button_text_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
  }

  .ai-testimonials-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg }};
    color: {{ block.settings.button_hover_text }};
    border-color: {{ block.settings.button_hover_border }};
    transform: translateY(-2px);
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: 40px;
  }

  .ai-testimonials-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.card_spacing }}px;
    margin-bottom: 40px;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow }};
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
  }

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_ratio }};
    border-radius: {{ block.settings.image_border_radius }}px;
    overflow: hidden;
    margin-bottom: {{ block.settings.image_spacing }}px;
    flex-shrink: 0;
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
  }

  .ai-testimonial-content-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.content_alignment }};
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-testimonial-star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    margin-bottom: 20px;
    text-align: {{ block.settings.content_alignment }};
    flex-grow: 1;
  }

  /* Bold AND italic text - red and new line */
  .ai-testimonial-text-{{ ai_gen_id }} strong em,
  .ai-testimonial-text-{{ ai_gen_id }} strong i,
  .ai-testimonial-text-{{ ai_gen_id }} b em,
  .ai-testimonial-text-{{ ai_gen_id }} b i,
  .ai-testimonial-text-{{ ai_gen_id }} em strong,
  .ai-testimonial-text-{{ ai_gen_id }} em b,
  .ai-testimonial-text-{{ ai_gen_id }} i strong,
  .ai-testimonial-text-{{ ai_gen_id }} i b {
    color: red !important;
    display: block !important;
  }

  .ai-testimonial-footer-{{ ai_gen_id }} {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    text-align: {{ block.settings.content_alignment }};
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_color }};
    margin: 0 0 4px;
  }

  .ai-testimonial-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.date_size }}px;
    color: {{ block.settings.date_color }};
    margin: 0;
  }

  .ai-testimonials-pagination-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 40px;
  }

  .ai-pagination-link-{{ ai_gen_id }} {
    padding: 10px 16px;
    background-color: {{ block.settings.pagination_bg }};
    color: {{ block.settings.pagination_text }};
    border-radius: {{ block.settings.pagination_border_radius }}px;
    text-decoration: none;
    transition: all 0.3s ease;
    border: 1px solid {{ block.settings.pagination_border }};
  }

  .ai-pagination-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.pagination_hover_bg }};
    color: {{ block.settings.pagination_hover_text }};
  }

  .ai-pagination-link-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.pagination_active_bg }};
    color: {{ block.settings.pagination_active_text }};
    border-color: {{ block.settings.pagination_active_bg }};
  }

  .ai-pagination-link-{{ ai_gen_id }}.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-testimonials-cta-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
{% endstyle %}

<div class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if block.settings.show_intro %}
      <div class="ai-testimonials-intro-{{ ai_gen_id }}">
        {% if block.settings.intro_text != blank %}
          <p class="ai-testimonials-intro-text-{{ ai_gen_id }}">{{ block.settings.intro_text }}</p>
        {% endif %}
        
        <div class="ai-testimonials-cta-{{ ai_gen_id }}">
          {% if block.settings.cta_text != blank %}
            <p class="ai-testimonials-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</p>
          {% endif %}
          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link }}" class="ai-testimonials-cta-button-{{ ai_gen_id }}">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-testimonials-header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-testimonials-title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <div class="ai-testimonials-subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.blog != blank %}
      {% assign posts_per_page = block.settings.posts_per_page %}
      {% paginate block.settings.blog.articles by posts_per_page %}
        <div class="ai-testimonials-grid-{{ ai_gen_id }}">
          {% for article in block.settings.blog.articles %}
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              {% if block.settings.show_image %}
                <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                  {% if article.image %}
                    <img
                      src="{{ article.image | image_url: width: 400 }}"
                      alt="{{ article.image.alt | escape }}"
                      class="ai-testimonial-image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                  {% else %}
                    <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
              {% endif %}

              <div class="ai-testimonial-content-{{ ai_gen_id }}">
                {% if block.settings.show_stars %}
                  <div class="ai-testimonial-stars-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.star_count) %}
                      <svg class="ai-testimonial-star-{{ ai_gen_id }}" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                      </svg>
                    {% endfor %}
                  </div>
                {% endif %}

                <div class="ai-testimonial-footer-{{ ai_gen_id }}" style="border: none; padding-top: 0; margin-bottom: 16px;">
                  <h3 class="ai-testimonial-author-{{ ai_gen_id }}">{{ article.title }}</h3>
                  {% if block.settings.show_date %}
                    <p class="ai-testimonial-date-{{ ai_gen_id }}">{{ article.published_at | date: block.settings.date_format }}</p>
                  {% endif %}
                </div>

                <div class="ai-testimonial-text-{{ ai_gen_id }}">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt }}
                  {% else %}
                    {{ article.content }}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <div class="ai-testimonials-pagination-{{ ai_gen_id }}">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="ai-pagination-link-{{ ai_gen_id }}">
                ← Previous
              </a>
            {% else %}
              <span class="ai-pagination-link-{{ ai_gen_id }} disabled">← Previous</span>
            {% endif %}

            {% for part in paginate.parts %}
              {% if part.is_link %}
                <a href="{{ part.url }}" class="ai-pagination-link-{{ ai_gen_id }}">
                  {{ part.title }}
                </a>
              {% else %}
                {% if part.title == paginate.current_page %}
                  <span class="ai-pagination-link-{{ ai_gen_id }} active">{{ part.title }}</span>
                {% else %}
                  <span class="ai-pagination-link-{{ ai_gen_id }}">{{ part.title }}</span>
                {% endif %}
              {% endif %}
            {% endfor %}

            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="ai-pagination-link-{{ ai_gen_id }}">
                Next →
              </a>
            {% else %}
              <span class="ai-pagination-link-{{ ai_gen_id }} disabled">Next →</span>
            {% endif %}
          </div>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <div style="text-align: center; padding: 60px 20px; background: #f4f4f4; border-radius: 8px;">
        <p style="font-size: 16px; color: #666; margin: 0;">Please select a blog to display testimonials</p>
      </div>
    {% endif %}
  </div>
</div>

