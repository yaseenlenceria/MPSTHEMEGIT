  {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- if upsell_count < upsell_limit -%}
  {%- if show_universal_any -%}
  {%- liquid
    assign upsell_product = blank

    if show_universal_footpegs
      assign upsell_product = all_products['puig_foot_pegs__racing-product-17312']
    endif

    if show_universal_bar_ends and upsell_product == blank
      assign upsell_product = all_products['puig_mirrors_ht4_bar_end_in_black_silver_various_models-product-17691']
    endif

    if show_universal_levers and upsell_product == blank
      assign upsell_product = all_products['puig_gen_3_racing_lever_adjusters']
    endif
  -%}

  {%- if upsell_product and upsell_product != blank -%}
    {%- assign upsell_count = upsell_count | plus: 1 -%}
    {%- assign upsell_alt = upsell_product.title | escape -%}
    <div class="cart-upsell panel mt-6">
      {%- if show_universal_footpegs -%}
        <h3 class="h6 mb-3">Upgrade your ride with PUIG Racing Footpegs</h3>
      {%- elsif show_universal_bar_ends -%}
        <h3 class="h6 mb-3">Complete your setup with PUIG Bar End Mirrors</h3>
      {%- else -%}
        <h3 class="h6 mb-3">Enhance control with PUIG Racing Lever Adjusters</h3>
      {%- endif -%}
      <div class="cart-upsell__content flex items-center gap-x-theme">
        <a class="cart-upsell__media block" href="{{ upsell_product.url }}">
          {%- if upsell_product.featured_image -%}
            {{ upsell_product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: upsell_alt }}
          {%- endif -%}
        </a>
        <div class="cart-upsell__details">
          <a class="link block mb-1" href="{{ upsell_product.url }}">{{ upsell_product.title | escape }}</a>
          <p class="text-sm mb-2">{{ upsell_product.price | money }}</p>
          <product-form class="block">
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ upsell_product.selected_or_first_available_variant.id }}">
              {%- if show_universal_footpegs -%}
                <button type="submit" class="btn btn--secondary btn--small">Add Racing Footpegs</button>
              {%- elsif show_universal_bar_ends -%}
                <button type="submit" class="btn btn--secondary btn--small">Add Bar End Mirrors</button>
              {%- else -%}
                <button type="submit" class="btn btn--secondary btn--small">Add Lever Adjusters</button>
              {%- endif -%}
            </form>
          </product-form>
        </div>
      </div>
    </div>
  {%- endif -%}
  {%- endif -%}
{%- endif -%}
