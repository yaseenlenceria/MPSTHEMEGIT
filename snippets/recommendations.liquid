          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if show_universal_footpegs_upsell and universal_footpegs_product and upsell_count < upsell_limit -%}
        {%- liquid
          assign cart_matches = cart.items | where: 'product_id', universal_footpegs_product.id
          assign id_token = ',' | append: universal_footpegs_product.id | append: ','
        -%}
        {%- if cart_matches.size == 0 -%}
          {%- if added_ids contains id_token -%}
            {%- assign skip_add = true -%}
          {%- else -%}
            {%- assign skip_add = false -%}
          {%- endif -%}
        {%- else -%}
          {%- assign skip_add = true -%}
        {%- endif -%}
        {%- if skip_add == false -%}
          {%- assign added_ids = added_ids | append: universal_footpegs_product.id | append: ',' -%}
          {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- assign rec_count = rec_count | plus: 1 -%}
          <li{% if carousel %} class="slider__item"{% endif %}>
            {%- render 'product-card-mini', product: universal_footpegs_product, always_open_quickbuy: always_open_quickbuy -%}
            <p class="text-sm mt-2">Improve grip and control with racing footpegs.</p>
          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if show_universal_bar_ends_upsell and universal_bar_ends_product and upsell_count < upsell_limit -%}
        {%- liquid
          assign cart_matches = cart.items | where: 'product_id', universal_bar_ends_product.id
          assign id_token = ',' | append: universal_bar_ends_product.id | append: ','
        -%}
        {%- if cart_matches.size == 0 -%}
          {%- if added_ids contains id_token -%}
            {%- assign skip_add = true -%}
          {%- else -%}
            {%- assign skip_add = false -%}
          {%- endif -%}
        {%- else -%}
          {%- assign skip_add = true -%}
        {%- endif -%}
        {%- if skip_add == false -%}
          {%- assign added_ids = added_ids | append: universal_bar_ends_product.id | append: ',' -%}
          {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- assign rec_count = rec_count | plus: 1 -%}
          <li{% if carousel %} class="slider__item"{% endif %}>
            {%- render 'product-card-mini', product: universal_bar_ends_product, always_open_quickbuy: always_open_quickbuy -%}
            <p class="text-sm mt-2">Balance your bars and finish the setup.</p>
          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if show_universal_levers_upsell and universal_levers_product and upsell_count < upsell_limit -%}
        {%- liquid
          assign cart_matches = cart.items | where: 'product_id', universal_levers_product.id
          assign id_token = ',' | append: universal_levers_product.id | append: ','
        -%}
        {%- if cart_matches.size == 0 -%}
          {%- if added_ids contains id_token -%}
            {%- assign skip_add = true -%}
          {%- else -%}
            {%- assign skip_add = false -%}
          {%- endif -%}
        {%- else -%}
          {%- assign skip_add = true -%}
        {%- endif -%}
        {%- if skip_add == false -%}
          {%- assign added_ids = added_ids | append: universal_levers_product.id | append: ',' -%}
          {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- assign rec_count = rec_count | plus: 1 -%}
          <li{% if carousel %} class="slider__item"{% endif %}>
            {%- render 'product-card-mini', product: universal_levers_product, always_open_quickbuy: always_open_quickbuy -%}
            <p class="text-sm mt-2">Fine-tune lever feel for better control.</p>
          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if show_bar_end_mirrors_upsell and bar_end_mirrors_product and upsell_count < upsell_limit -%}
        {%- liquid
          assign cart_matches = cart.items | where: 'product_id', bar_end_mirrors_product.id
          assign id_token = ',' | append: bar_end_mirrors_product.id | append: ','
        -%}
        {%- if cart_matches.size == 0 -%}
          {%- if added_ids contains id_token -%}
            {%- assign skip_add = true -%}
          {%- else -%}
            {%- assign skip_add = false -%}
          {%- endif -%}
        {%- else -%}
          {%- assign skip_add = true -%}
        {%- endif -%}
        {%- if skip_add == false -%}
          {%- assign added_ids = added_ids | append: bar_end_mirrors_product.id | append: ',' -%}
          {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- assign rec_count = rec_count | plus: 1 -%}
          <li{% if carousel %} class="slider__item"{% endif %}>
            {%- render 'product-card-mini', product: bar_end_mirrors_product, always_open_quickbuy: always_open_quickbuy -%}
            <p class="text-sm mt-2">Clean bar-end mirrors to match your controls.</p>
          </li>
        {%- endif -%}
      {%- endif -%}
      {%- if show_only_upsells == false -%}
        {%- assign source_products = fallback_products | default: recommendations.products -%}
        {%- for product in source_products -%}
          {%- if is_cart -%}
            {%- liquid
              if rec_count == products_to_show
                break
              endif
              assign cart_matches = cart.items | where: 'product_id', product.id
              assign cart_fallback_allowed = true
              if cart_bike_make != blank
                assign cart_fallback_allowed = false
                assign fallback_title = product.title | downcase
                assign fallback_type = product.type | downcase
                assign fallback_tags = product.tags | join: ',' | downcase
                assign fallback_title_compact = fallback_title | remove: ' ' | remove: '-' | remove: '/' | remove: '(' | remove: ')' | remove: '.'
                assign fallback_is_associated = false
                if has_exhaust
                  if fallback_title contains 'filter' or fallback_type contains 'filter' or fallback_tags contains 'air filter' or fallback_title contains 'tail tidy' or fallback_title contains 'screen' or fallback_title contains 'crash' or fallback_title contains 'radiator guard' or fallback_title contains 'tank grip' or fallback_title contains 'decat' or fallback_title contains 'gasket' or fallback_title contains 'db killer' or fallback_title contains 'ecu' or fallback_title contains 'remap'
                    assign fallback_is_associated = true
                  endif
                endif
                if has_dna_in_cart
                  if fallback_title contains 'exhaust' or fallback_type contains 'exhaust' or fallback_title contains 'spark plug' or fallback_title contains 'airbox' or fallback_title contains 'velocity stack' or fallback_title contains 'intake' or fallback_title contains 'service kit' or fallback_title contains 'cleaning kit' or fallback_title contains 'ecu' or fallback_title contains 'remap'
                    assign fallback_is_associated = true
                  endif
                endif
                if has_puig_screen
                  if fallback_title contains 'hand guard' or fallback_title contains 'phone' or fallback_title contains 'tank bag' or fallback_title contains 'seat' or fallback_title contains 'gps' or fallback_title contains 'top box' or fallback_title contains 'wind deflector'
                    assign fallback_is_associated = true
                  endif
                endif
                if fallback_is_associated == false and fallback_title contains 'tail tidy'
                  assign fallback_is_associated = true
                endif
                if fallback_title contains cart_bike_make and fallback_is_associated
                  assign cart_fitment_tokens = cart_fitment_words | split: ','
                  for cart_fitment_token in cart_fitment_tokens
                    if cart_fitment_token != blank
                      assign cart_fitment_token_compact = cart_fitment_token | remove: ' ' | remove: '-'
                      if fallback_title contains cart_fitment_token or fallback_title_compact contains cart_fitment_token_compact
                        assign cart_fallback_allowed = true
                        break
                      endif
                    endif
                  endfor
                endif
              endif
            -%}
            {%- if cart_matches.size == 0 and cart_fallback_allowed -%}
              {%- assign rec_count = rec_count | plus: 1 -%}
              <li{% if carousel %} class="slider__item"{% endif %}>
                {%- render 'product-card-mini', product: product, always_open_quickbuy: always_open_quickbuy -%}
              </li>
            {%- endif -%}
          {%- else -%}
            <li{% if carousel %} class="slider__item"{% endif %}>
              {%- render 'product-card-mini', product: product, always_open_quickbuy: always_open_quickbuy -%}
