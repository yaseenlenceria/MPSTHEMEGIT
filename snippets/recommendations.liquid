        </li>
      {%- endif -%}
      {%- if show_puig_visor_upsell and puig_visor_product and upsell_count < upsell_limit -%}
        {%- liquid
          assign cart_matches = cart.items | where: 'product_id', puig_visor_product.id
          assign id_token = ',' | append: puig_visor_product.id | append: ','
        -%}
        {%- if cart_matches.size == 0 -%}
          {%- if added_ids contains id_token -%}
            {%- assign skip_add = true -%}
          {%- else -%}
            {%- assign skip_add = false -%}
          {%- endif -%}
        {%- else -%}
          {%- assign skip_add = true -%}
        {%- endif -%}
        {%- if skip_add == false -%}
          {%- assign added_ids = added_ids | append: puig_visor_product.id | append: ',' -%}
          {%- assign upsell_count = upsell_count | plus: 1 -%}
          {%- assign rec_count = rec_count | plus: 1 -%}
          <li{% if carousel %} class="slider__item"{% endif %}>
            {%- render 'product-card-mini', product: puig_visor_product, always_open_quickbuy: always_open_quickbuy -%}
