          {%- endif -%}
        {%- endfor -%}
        {%- if is_cart and rec_count == 0 and cart_bike_make != blank -%}
          {%- for product in source_products -%}
            {%- liquid
              if rec_count == products_to_show
                break
              endif
              assign cart_matches = cart.items | where: 'product_id', product.id
              assign fallback_title = product.title | downcase
              assign fallback_type = product.type | downcase
              assign fallback_tags = product.tags | join: ',' | downcase
              assign same_make_allowed = false
              assign fallback_is_associated = false
              if has_exhaust
                if fallback_title contains 'filter' or fallback_type contains 'filter' or fallback_tags contains 'air filter' or fallback_title contains 'tail tidy' or fallback_title contains 'screen' or fallback_title contains 'crash' or fallback_title contains 'radiator guard' or fallback_title contains 'tank grip' or fallback_title contains 'decat' or fallback_title contains 'gasket' or fallback_title contains 'db killer' or fallback_title contains 'ecu' or fallback_title contains 'remap'
                  assign fallback_is_associated = true
                endif
              endif
              if has_dna_in_cart
                if fallback_title contains 'exhaust' or fallback_type contains 'exhaust' or fallback_title contains 'spark plug' or fallback_title contains 'airbox' or fallback_title contains 'velocity stack' or fallback_title contains 'intake' or fallback_title contains 'service kit' or fallback_title contains 'cleaning kit' or fallback_title contains 'ecu' or fallback_title contains 'remap'
                  assign fallback_is_associated = true
                endif
              endif
              if has_puig_screen
                if fallback_title contains 'hand guard' or fallback_title contains 'phone' or fallback_title contains 'tank bag' or fallback_title contains 'seat' or fallback_title contains 'gps' or fallback_title contains 'top box' or fallback_title contains 'wind deflector'
                  assign fallback_is_associated = true
                endif
              endif
              if fallback_title contains cart_bike_make and fallback_is_associated
                assign same_make_allowed = true
              endif
            -%}
            {%- if cart_matches.size == 0 and same_make_allowed -%}
              {%- assign rec_count = rec_count | plus: 1 -%}
              <li{% if carousel %} class="slider__item"{% endif %}>
                {%- render 'product-card-mini', product: product, always_open_quickbuy: always_open_quickbuy -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
      {%- if is_cart and rec_count == 0 -%}
        {%- liquid
          assign universal_fallback_collection = collections['universal-products-for-your-bike-other']
          if universal_fallback_collection == nil or universal_fallback_collection.products == blank
            assign universal_fallback_collection = collections['Universal Products For Your Bike Other']
          endif
          assign cart_universal_fallback_product = blank
          if has_exhaust or has_dna_in_cart or has_puig_screen
            assign cart_universal_fallback_product = all_products['puig_foot_pegs__racing-product-17312']
            if cart_universal_fallback_product == blank
              assign cart_universal_fallback_product = all_products['puig_mirrors_ht4_bar_end_in_black_silver_various_models-product-17691']
            endif
            if cart_universal_fallback_product == blank
              assign cart_universal_fallback_product = all_products['puig_extender_visor__screwon-_3_sizes-product-15965']
            endif
          endif
        -%}
        {%- if universal_fallback_collection and universal_fallback_collection.products != blank -%}
          {%- for product in universal_fallback_collection.products -%}
            {%- liquid
              assign cart_matches = cart.items | where: 'product_id', product.id
              assign universal_title = product.title | downcase
              assign universal_type = product.type | downcase
              assign universal_tags = product.tags | join: ',' | downcase
              assign universal_allowed = false
              if has_exhaust
                if universal_title contains 'paddock' or universal_title contains 'stand' or universal_title contains 'protector' or universal_title contains 'protection' or universal_title contains 'crash' or universal_title contains 'guard' or universal_title contains 'footpeg' or universal_title contains 'foot peg' or universal_type contains 'foot' or universal_tags contains 'universal'
                  assign universal_allowed = true
                endif
              elsif has_dna_in_cart
                if universal_title contains 'service' or universal_title contains 'clean' or universal_title contains 'intake' or universal_title contains 'velocity' or universal_tags contains 'universal'
                  assign universal_allowed = true
                endif
              elsif has_puig_screen
                if universal_title contains 'phone' or universal_title contains 'tank bag' or universal_title contains 'top box' or universal_title contains 'gps' or universal_title contains 'guard' or universal_tags contains 'universal'
                  assign universal_allowed = true
                endif
              elsif universal_tags contains 'universal'
                assign universal_allowed = true
              endif
            -%}
            {%- if cart_matches.size == 0 and universal_allowed -%}
              {%- assign rec_count = rec_count | plus: 1 -%}
              <li{% if carousel %} class="slider__item"{% endif %}>
                {%- render 'product-card-mini', product: product, always_open_quickbuy: always_open_quickbuy -%}
              </li>
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- if rec_count == 0 and cart_universal_fallback_product -%}
          {%- assign cart_matches = cart.items | where: 'product_id', cart_universal_fallback_product.id -%}
          {%- if cart_matches.size == 0 -%}
            {%- assign rec_count = rec_count | plus: 1 -%}
            <li{% if carousel %} class="slider__item"{% endif %}>
              {%- render 'product-card-mini', product: cart_universal_fallback_product, always_open_quickbuy: always_open_quickbuy -%}
            </li>
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    </ul>

    {%- if carousel -%}
          </div>
        </div>
      </carousel-slider>
    {%- endif -%}
  {%- endif -%}
</product-recommendations>
