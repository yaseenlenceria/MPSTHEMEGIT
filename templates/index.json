        "template--17646024294688__7ff2d165-a729-4f5c-a6dc-805d6957f606-16751794779331fd75-0": {
          "type": "category",
          "settings": {
            "text": "At Motorcycle Performance Store, every order is handled with care from start to finish. Here’s what happens once you place your order with us 👇"
          }
        },
        "template--17646024294688__7ff2d165-a729-4f5c-a6dc-805d6957f606-16751794779331fd75-1": {
          "type": "question",
          "settings": {
            "icon": "phone",
            "heading": "Order Confirmation",
            "text": "<p>Once you’ve placed your order, you’ll receive a confirmation email right away.<br/>Our system double-checks product availability and verifies secure payment so you can shop with confidence.</p>"
          }
        },
        "template--17646024294688__7ff2d165-a729-4f5c-a6dc-805d6957f606-16751794779331fd75-2": {
          "type": "question",
          "settings": {
            "icon": "check_mark",
            "heading": "Product Preparation",
            "text": "<p>Next, our team carefully picks, packs, and inspects your items.<br/>Whether it’s a Termignoni exhaust, Puig screen, or DNA Air filter, we make sure it’s in perfect condition before being despatched.</p>"
          }
        },
        "question_GQeyQm": {
          "type": "question",
          "settings": {
            "icon": "map_pin",
            "heading": "Fast Dispatch & Tracking",
            "text": "<p>Your order is then dispatched within 24–48 hours (excluding weekends).<br/>We’ll send you a tracking number so you can follow your delivery every step of the way — whether you’re in the UK or abroad.</p>"
          }
        },
        "question_9xT8mY": {
          "type": "question",
          "settings": {
            "icon": "award",
            "heading": "Safe Delivery",
            "text": "<p>Your package arrives securely packed and protected, ready to be fitted to your bike.<br/>We only work with trusted couriers to ensure your products reach you fast and safely.</p>"
          }
        }
      },
      "block_order": [
        "template--17646024294688__7ff2d165-a729-4f5c-a6dc-805d6957f606-16751794779331fd75-0",
