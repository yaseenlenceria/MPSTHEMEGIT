{% doc %}
  @prompt
    I want a landscape block to add a picture, The width is 2000 pixels by 350 pixels high, Ok now I need the same block again underneath to add another picture
    
    , Right I need it 1100 pixel wide by 125 pixel high
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-landscape-image-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1100px;
    margin: 0 auto;
  }

  .ai-landscape-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 125px;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-landscape-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-landscape-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-landscape-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 125px;
  }

  .ai-landscape-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 12px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    .ai-landscape-image-wrapper-{{ ai_gen_id }} {
      height: 100px;
    }
  }
{% endstyle %}

<div class="ai-landscape-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-landscape-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.image %}
      <img
        src="{{ block.settings.image | image_url: width: 1100 }}"
        alt="{{ block.settings.image.alt | escape }}"
        loading="lazy"
        width="1100"
        height="125"
      >
    {% else %}
      <div class="ai-landscape-image-placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
        <div class="ai-landscape-empty-state-{{ ai_gen_id }}">
          Add a landscape image (1100 x 125px)
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Landscape image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Landscape image"
    }
  ]
}
{% endschema %}
