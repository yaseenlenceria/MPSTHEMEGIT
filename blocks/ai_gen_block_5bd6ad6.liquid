{% doc %}
  @prompt
    CUSTOMERS OUTSIDE OF THE UK: VAT will not be charged at checkout. Local taxes may be payable in your country before or upon delivery. For USA customers, a duty payment link will be sent to you — this will enable your order to clear customs without any delays. make a greate section CUSTOMERS OUTSIDE OF THE UK in read and follow there responsive small section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-uk-notice-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    border-left: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .ai-uk-notice-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-uk-notice-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.spacing }}px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .ai-uk-notice-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-uk-notice-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_vertical | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px;
    }

    .ai-uk-notice-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
      margin-bottom: {{ block.settings.spacing | times: 0.7 }}px;
    }

    .ai-uk-notice-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-uk-notice-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-uk-notice-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-uk-notice-heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </div>
    {% endif %}
    {% if block.settings.message != blank %}
      <div class="ai-uk-notice-text-{{ ai_gen_id }}">
        {{ block.settings.message }}
      </div>
    {% endif %}
  </div>
</div>

