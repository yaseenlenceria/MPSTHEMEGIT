{%- comment -%}
  Parameters:
  - product {Object} - Product object.

  Usage:
  {% render 'structured-data-product', product: product %}
{%- endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign product_url = shop.url | append: product.url
    assign product_id = product_url | append: '#product'
    assign current_variant = product.selected_or_first_available_variant
    assign price_valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'

    assign description_value = product.description | strip_html | strip
    if description_value == blank and product.metafields.seo.description != blank
      assign description_value = product.metafields.seo.description | strip_html | strip
    elsif description_value == blank and product.metafields.global.description_tag != blank
      assign description_value = product.metafields.global.description_tag | strip_html | strip
    endif
    if description_value != blank
      assign description_value = description_value | truncate: 5000
    endif

    assign product_images = product.images

    # Aggregate rating - check Judge.me metafields first, then Shopify native reviews
    assign rating_value = nil
    assign review_count_num = 0

    if product.metafields.judgeme != blank and product.metafields.judgeme.badge != blank
      assign jm_rating = product.metafields.judgeme.badge | split: "data-average-rating='" | last | split: "'" | first
      assign jm_count = product.metafields.judgeme.badge | split: "data-number-of-reviews='" | last | split: "'" | first
      assign jm_rating_num = jm_rating | plus: 0.0
      assign jm_count_num = jm_count | plus: 0
      if jm_rating_num > 0.0 and jm_count_num > 0
        assign rating_value = jm_rating_num
        assign review_count_num = jm_count_num
      endif
    endif

    # Fallback to Shopify native review metafields
    if rating_value == nil and product.metafields.reviews != blank
      if product.metafields.reviews.rating.value != blank
        assign rating_value = product.metafields.reviews.rating.value | plus: 0.0
        assign review_count_num = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
      endif
    endif
  -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ product_id | json }},
      "name": {{ product.title | json }},
      "url": {{ product_url | json }},
      {% if product_images.size > 0 %}
        "image": [
          {%- for image in product_images -%}
            {{ image | image_url: width: 1200 | prepend: "https:" | json }}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ],
      {% endif %}
      {% if description_value != blank %}
        "description": {{ description_value | json }},
      {% endif %}
      {% if product.vendor != blank %}
        "brand": {
          "@type": "Brand",
          "name": {{ product.vendor | json }}
        },
      {% endif %}
      {% if rating_value != nil and review_count_num > 0 %}
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ rating_value | json }},
          "reviewCount": {{ review_count_num | json }},
          "bestRating": "5",
          "worstRating": "1"
        },
      {% endif %}
      "offers": [
        {%- for variant in product.variants -%}
          {%- liquid
            assign variant_price = variant.price | divided_by: 100.0
            assign variant_url = shop.url | append: variant.url
            assign variant_sku = variant.sku | strip
            assign variant_sku_has_space = false
            if variant_sku contains ' '
              assign variant_sku_has_space = true
            endif
          -%}
          {
            "@type": "Offer",
            "@id": {{ variant_url | append: '#offer' | json }},
            "url": {{ variant_url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ variant_price | json }},
            "priceValidUntil": {{ price_valid_until | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "shippingDetails": {
              "@type": "OfferShippingDetails",
              "shippingRate": {
                "@type": "MonetaryAmount",
                "value": "0",
                "currency": {{ cart.currency.iso_code | json }}
              },
              "shippingDestination": {
                "@type": "DefinedRegion",
                "addressCountry": {{ cart.currency.iso_code | replace: 'GBP', 'GB' | replace: 'EUR', 'EU' | replace: 'USD', 'US' | json }}
              },
              "deliveryTime": {
                "@type": "ShippingDeliveryTime",
                "handlingTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 1,
                  "maxValue": 3,
                  "unitCode": "DAY"
                },
                "transitTime": {
                  "@type": "QuantitativeValue",
                  "minValue": 2,
                  "maxValue": 5,
                  "unitCode": "DAY"
                }
              }
            },
            "hasMerchantReturnPolicy": {
              "@type": "MerchantReturnPolicy",
              "applicableCountry": {{ cart.currency.iso_code | replace: 'GBP', 'GB' | replace: 'EUR', 'EU' | replace: 'USD', 'US' | json }},
              "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
              "merchantReturnDays": 30,
              "returnMethod": "https://schema.org/ReturnByMail",
              "returnFees": "https://schema.org/FreeReturn"
            },
            "seller": {
              "@id": {{ shop.url | append: '#organization' | json }}
            }
            {% if variant_sku != blank and variant_sku_has_space == false %},
              "sku": {{ variant_sku | json }}
            {% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
