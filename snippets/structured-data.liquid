{% comment %}
  Article structured data
  https://developers.google.com/search/docs/data-types/articles
{% endcomment %}

{% if template contains 'article' %}
  {%- capture article_description  -%}
    {%- if article.excerpt != blank -%}
      {{ article.excerpt | strip_html }}
    {%- else -%}
      {{ article.content | truncatewords: 100 | strip_html }}
    {%- endif -%}
  {%- endcapture -%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "{{ shop.url }}{{ article.url }}"
      },
      "headline": {{ article.title | json }},
      {% if article.image %}
        "image": [
          {% for image in article.images limit: 5 %}
            {
              "@type": "ImageObject",
              "url": {{ image | img_url: '1024x1024' | prepend: 'https:' | json }},
              "height": 1024,
              "width": 1024
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ],
      {% endif %}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json}},
      "dateModified": {{ article.updated_at | default: article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json}},
      "author": {
        "@type": "Person",
        "name": {{ article.author | json }}
      },
      "publisher": {
        "@type": "Organization",
        "@id": "{{ shop.url }}#organization",
        "name": {{ shop.name | json }},
        "logo": {
          "@type": "ImageObject",
          "url": "{{ shop.logo | img_url: '500x500' | default: 'https:' | append: '//cdn.shopify.com/s/files/1/0553/1793/2996/files/Logo_620x151.png?v=1657716394' }}",
          "width": 500,
          "height": 500
        }
      },
      "description": {{ article_description | json }}
    }
  </script>
{% endif %}

{% comment %}
  Breadcrumbs
  https://developers.google.com/search/docs/data-types/breadcrumbs
{% endcomment %}

{%- if current_tags -%}
  {%- assign tag_names = current_tags | join: ', ' %}
  {% comment %}Converting an array to a handle converts it to a string{% endcomment %}
  {%- capture tag_handles -%}
    {%- for tag in current_tags -%}
      {{- tag | handle | append: '|' -}}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{% if collection.url == blank %}
  {% assign collection_url = '/collections/all' %}
{% else %}
  {% assign collection_url = collection.url %}
{% endif %}

{% if template.name == 'product'
    or template.name == 'list-collections'
    or template.name == 'collection'
    or template.name == 'blog'
    or template.name == 'article'
    or template.name == 'search'
    or template.name == 'cart'
    or template.name == 'page'
%}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
      {% case template.name %}
        {% when 'product' %}
          {% if product.collections.size >= 1 %}
            {
              "@type": "ListItem",
              "position": 1,
              "name": {{ 'structured_data.breadcrumbs.collections' | t | json }},
              "item": "{{ shop.url }}/collections"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ product.collections.first.title | json }},
              "item": "{{ shop.url }}/collections/{{ product.collections.first.handle }}"
            },
          {% else %}
            {
              "@type": "ListItem",
              "position": 1,
              "name": {{ 'structured_data.breadcrumbs.products' | t | json }},
              "item": "{{ shop.url }}/products"
            },
          {% endif %}
          {
            "@type": "ListItem",
            "position": {% if product.collections.size >= 1 %}3{% else %}2{% endif %},
            "name": {{ product.title | json }},
            "item": "{{ shop.url }}{{ product.url }}"
          }
        {% when 'list-collections' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'structured_data.breadcrumbs.collections' | t | json }},
            "item": "{{ shop.url }}/collections"
          }
          {% if current_page != 1 %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ 'structured_data.breadcrumbs.page' | t: page: current_page | json }},
              "item": "{{ shop.url }}/collections?page={{ current_page }}"
            }
          {% endif %}
        {% when 'collection' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'structured_data.breadcrumbs.collections' | t | json }},
            "item": "{{ shop.url }}/collections"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": "{{ shop.url }}{{ collection_url }}"
          }
          {% if current_tags %}
            ,
            {
              "@type": "ListItem",
              "position": 3,
              "name": {{ 'structured_data.breadcrumbs.tags_html' | t: tags: tag_names | json }},
              "item": "{{ shop.url }}{{ collection_url }}/{{- tag_handles | split: '|' | join: '+' -}}"
            }
          {% endif %}
          {% if current_page != 1 %}
            {% if current_tags %}
              {% assign position = 4 %}
            {% else %}
              {% assign position = 3 %}
            {% endif %}
            ,
            {
              "@type": "ListItem",
              "position": {{ position }},
              "name": {{ 'structured_data.breadcrumbs.page' | t: page: current_page | json }},
              "item": "{{ shop.url }}{{ collection_url }}?page={{ current_page }}"
            }
          {% endif %}
        {% when 'blog' or 'article' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ blog.title | json }},
            "item": "{{ shop.url }}{{ blog.url }}"
          }
          {% if template.name == 'article' %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ article.title | json }},
              "item": "{{ shop.url }}{{ article.url }}"
            }
          {% elsif current_tags %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ 'structured_data.breadcrumbs.tags_html' | t: tags: tag_names | json }},
              "item": "{{ shop.url }}{{ blog.url }}/tagged/{{- tag_handles | split: '|' | join: '+' -}}"
            }
          {% endif %}
          {% if current_page != 1 %}
            {% if current_tags %}
              {% assign position = 3 %}
              {%- capture url -%}
                {{ shop.url }}{{ blog.url }}/tagged/{{ tag_handles | split: '|' | join: '+' }}?page={{ current_page }}
              {%- endcapture -%}
            {% else %}
              {% assign position = 2 %}
                {%- capture url -%}
                {{ shop.url }}{{ blog.url }}?page={{ current_page }}
              {%- endcapture -%}
            {% endif %}
            ,
            {
              "@type": "ListItem",
              "position": {{ position }},
              "name": {{ 'structured_data.breadcrumbs.page' | t: page: current_page | json }},
              "item": "{{ url }}"
            }
          {% endif %}
        {% when 'search' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'structured_data.breadcrumbs.search' | t | json }},
            "item": "{{ shop.url }}/search"
          }
          {% if search.performed %}
            ,
            {
              "@type": "ListItem",
              "position": 2,
              "name": {{ search.terms | json }},
              "item": "{{ shop.url }}/search?q={{ search.terms }}"
            }
            {% if current_page != 1 %}
              ,
              {
                "@type": "ListItem",
                "position": 3,
                "name": {{ 'structured_data.breadcrumbs.page' | t: page: current_page | json }},
                "item": "{{ shop.url }}/search?page={{ current_page }}&q={{ search.terms }}"
              }
            {% endif %}
          {% endif %}
        {% when 'cart' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ 'structured_data.breadcrumbs.cart' | t | json }},
            "item": "{{ shop.url }}/cart"
          }
        {% when 'page' %}
          {
            "@type": "ListItem",
            "position": 1,
            "name": {{ page.title | json }},
            "item": "{{ shop.url }}{{ page.url }}"
          }
        {% else %}
        {% endcase %}
      ]
    }
  </script>
{% endif %}

{% comment %}
  Store information
  https://developers.google.com/search/docs/data-types/sitename
{% endcomment %}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": "{{ shop.url }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    },
    "publisher": {
      "@type": "Organization",
      "@id": "{{ shop.url }}#organization",
      "name": {{ shop.name | json }},
      "url": "{{ shop.url }}",
      "logo": {
        "@type": "ImageObject",
        "url": "{{ shop.logo | img_url: '500x500' | default: 'https:' | append: '//cdn.shopify.com/s/files/1/0553/1793/2996/files/Logo_620x151.png?v=1657716394' }}",
        "width": 500,
        "height": 500
      },
      "sameAs": [
        {% if settings.social_facebook != blank %}
          "{{ settings.social_facebook }}",
        {% endif %}
        {% if settings.social_instagram != blank %}
          "{{ settings.social_instagram }}",
        {% endif %}
        {% if settings.social_youtube != blank %}
          "{{ settings.social_youtube }}",
        {% endif %}
        {% if settings.social_pinterest != blank %}
          "{{ settings.social_pinterest }}",
        {% endif %}
        {% if settings.social_tiktok != blank %}
          "{{ settings.social_tiktok }}",
        {% endif %}
        "https://www.facebook.com/MotorcyclePerformanceStore",
        "https://www.instagram.com/motorcycleperformancestore",
        "https://www.youtube.com/@MotorcyclePerformanceStore",
        "https://www.pinterest.co.uk/motorcycleperformancestore",
        "https://www.tiktok.com/@motorcycleperformancestore"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+44-1600-772121",
        "contactType": "customer service",
        "areaServed": "GB",
        "availableLanguage": "en"
      },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Bank Street",
        "addressLocality": "Coleford",
        "addressRegion": "Gloucestershire",
        "postalCode": "GL16 8BA",
        "addressCountry": "GB"
      }
    }
  }
</script>
