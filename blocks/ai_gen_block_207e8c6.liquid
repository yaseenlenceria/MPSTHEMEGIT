{% doc %}
  @prompt
    I need two text boxes.
    
    One on the left hand side and a smaller text box on the right hand side
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-text-boxes-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-two-text-boxes__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    align-items: flex-start;
  }

  .ai-two-text-boxes__left-{{ ai_gen_id }} {
    flex: 1;
    background-color: {{ block.settings.left_bg_color }};
    padding: {{ block.settings.left_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-text-boxes__right-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.right_width }}%;
    background-color: {{ block.settings.right_bg_color }};
    padding: {{ block.settings.right_padding }}px;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-text-boxes__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-two-text-boxes__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.6;
  }

  @media screen and (max-width: 749px) {
    .ai-two-text-boxes__container-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-two-text-boxes__right-{{ ai_gen_id }} {
      flex: 1;
    }
  }
{% endstyle %}

<two-text-boxes-{{ ai_gen_id }}
  class="ai-two-text-boxes-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-two-text-boxes__container-{{ ai_gen_id }}">
    <div class="ai-two-text-boxes__left-{{ ai_gen_id }}">
      {% if block.settings.left_heading != blank %}
        <h3 class="ai-two-text-boxes__heading-{{ ai_gen_id }}">{{ block.settings.left_heading }}</h3>
      {% endif %}
      {% if block.settings.left_text != blank %}
        <div class="ai-two-text-boxes__text-{{ ai_gen_id }}">{{ block.settings.left_text }}</div>
      {% endif %}
    </div>

    <div class="ai-two-text-boxes__right-{{ ai_gen_id }}">
      {% if block.settings.right_heading != blank %}
        <h3 class="ai-two-text-boxes__heading-{{ ai_gen_id }}">{{ block.settings.right_heading }}</h3>
      {% endif %}
      {% if block.settings.right_text != blank %}
        <div class="ai-two-text-boxes__text-{{ ai_gen_id }}">{{ block.settings.right_text }}</div>
      {% endif %}
    </div>
  </div>
</two-text-boxes-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoTextBoxes{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }
    }

    customElements.define('two-text-boxes-{{ ai_gen_id }}', TwoTextBoxes{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Two text boxes",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Left box"
    },
    {
      "type": "inline_richtext",
      "id": "left_heading",
      "label": "Heading",
      "default": "Main content"
    },
    {
      "type": "richtext",
      "id": "left_text",
      "label": "Text",
      "default": "<p>This is the larger text box on the left side. Add your main content here.</p>"
    },
    {
      "type": "color",
      "id": "left_bg_color",
      "label": "Background color",
      "default": "#f4f4f4"
    },
    {
      "type": "range",
      "id": "left_padding",
      "label": "Padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Right box"
    },
    {
      "type": "inline_richtext",
      "id": "right_heading",
      "label": "Heading",
      "default": "Side note"
    },
    {
      "type": "richtext",
      "id": "right_text",
      "label": "Text",
      "default": "<p>This is the smaller text box on the right side.</p>"
    },
    {
      "type": "color",
      "id": "right_bg_color",
      "label": "Background color",
      "default": "#ff580d"
    },
    {
      "type": "range",
      "id": "right_padding",
      "label": "Padding",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "right_width",
      "label": "Width",
      "min": 20,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between boxes",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#2a2b2a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 16,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Heading spacing",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#2a2b2a"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 26,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Two text boxes"
    }
  ]
}
{% endschema %}