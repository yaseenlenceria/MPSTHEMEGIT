      "type": "checkbox",
      "id": "sort_show_best",
      "label": "Enable order: Best selling",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sort_show_alpha",
      "label": "Enable order: Alphabetical",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sort_show_price",
      "label": "Enable order: Price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sort_show_date",
      "label": "Enable order: Date added",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "The collection's default sort order will always show."
    },
    {
      "type": "checkbox",
      "id": "sort_first",
      "label": "Show the sort options first on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Additional Collection"
    },
    {
      "type": "collection",
      "id": "additional_collection",
      "label": "Select additional collection",
      "info": "Products from this collection will be displayed below the main collection products"
    },
    {
      "type": "range",
      "id": "additional_collection_limit",
      "min": 4,
      "max": 50,
      "step": 1,
      "label": "Number of products to show",
      "info": "Maximum number of products to display from the additional collection",
      "default": 8
    }
  ],
