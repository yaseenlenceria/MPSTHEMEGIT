{% doc %}
  @prompt
    Make seo optomized H1 section for SEO 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-seo-h1-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    text-align: {{ block.settings.text_alignment }};
  }

  @media screen and (min-width: 750px) {
    .ai-seo-h1-section-{{ ai_gen_id }} {
      width: {{ block.settings.desktop_width_percent }}%;
      margin: 0 auto;
    }
  }

  .ai-seo-h1-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_content_width }}px;
    margin: 0 auto;
  }

  .ai-seo-h1-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: {{ block.settings.eyebrow_spacing }}px;
    font-weight: 600;
    letter-spacing: 0.05em;
    {% if block.settings.eyebrow_uppercase %}
      text-transform: uppercase;
    {% endif %}
  }

  .ai-seo-h1-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_mobile }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.2;
    font-weight: 700;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-style: {{ block.settings.heading_font.style }};
    font-weight: {{ block.settings.heading_font.weight }};
  }

  @media screen and (min-width: 750px) {
    .ai-seo-h1-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-seo-h1-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px;
    line-height: 1.6;
    max-width: {{ block.settings.subheading_max_width }}px;
    {% if block.settings.text_alignment == 'center' %}
      margin-left: auto;
      margin-right: auto;
    {% elsif block.settings.text_alignment == 'right' %}
      margin-left: auto;
    {% endif %}
  }

  .ai-seo-h1-breadcrumb-{{ ai_gen_id }} {
    font-size: {{ block.settings.breadcrumb_size }}px;
    color: {{ block.settings.breadcrumb_color }};
    margin-bottom: {{ block.settings.breadcrumb_spacing }}px;
  }

  .ai-seo-h1-breadcrumb-{{ ai_gen_id }} a {
    color: {{ block.settings.breadcrumb_link_color }};
    text-decoration: none;
  }

  .ai-seo-h1-breadcrumb-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
  }

  .ai-seo-h1-breadcrumb-{{ ai_gen_id }} span {
    margin: 0 8px;
    opacity: 0.5;
  }

  .ai-seo-h1-schema-{{ ai_gen_id }} {
    display: none;
  }
{% endstyle %}

<seo-h1-section-{{ ai_gen_id }}
  class="ai-seo-h1-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-seo-h1-container-{{ ai_gen_id }}">
    {% if block.settings.show_breadcrumb %}
      <nav class="ai-seo-h1-breadcrumb-{{ ai_gen_id }}" aria-label="Breadcrumb">
        {% if block.settings.breadcrumb_home_text != blank %}
          <a href="/">{{ block.settings.breadcrumb_home_text }}</a>
          <span>›</span>
        {% endif %}
        {% if block.settings.breadcrumb_parent_text != blank and block.settings.breadcrumb_parent_url != blank %}
          <a href="{{ block.settings.breadcrumb_parent_url }}">{{ block.settings.breadcrumb_parent_text }}</a>
          <span>›</span>
        {% endif %}
        {% if block.settings.breadcrumb_current_text != blank %}
          <span>{{ block.settings.breadcrumb_current_text }}</span>
        {% endif %}
      </nav>
    {% endif %}

    {% if block.settings.eyebrow_text != blank %}
      <div class="ai-seo-h1-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow_text }}
      </div>
    {% endif %}

    {% if block.settings.heading_text != blank %}
      <h1 class="ai-seo-h1-heading-{{ ai_gen_id }}">
        {{ block.settings.heading_text }}
      </h1>
    {% else %}
      <h1 class="ai-seo-h1-heading-{{ ai_gen_id }}">
        {% if collection %}
          {{ collection.title }}
        {% elsif product %}
          {{ product.title }}
        {% elsif page %}
          {{ page.title }}
        {% elsif blog %}
          {{ blog.title }}
        {% elsif article %}
          {{ article.title }}
        {% else %}
          {{ page_title }}
        {% endif %}
      </h1>
    {% endif %}

    {% if block.settings.subheading_text != blank %}
      <div class="ai-seo-h1-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading_text }}
      </div>
    {% endif %}

    {% if block.settings.enable_schema %}
      <script type="application/ld+json" class="ai-seo-h1-schema-{{ ai_gen_id }}">
      {
        "@context": "https://schema.org",
        "@type": "WebPage",
        "name": "{{ block.settings.heading_text | default: page_title | escape }}",
        "description": "{{ block.settings.subheading_text | strip_html | escape }}",
        "url": "{{ canonical_url }}"
      }
      </script>
    {% endif %}
  </div>
</seo-h1-section-{{ ai_gen_id }}>

<script>
  (function() {
    class SeoH1Section{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.checkH1Uniqueness();
      }

      checkH1Uniqueness() {
        const h1Elements = document.querySelectorAll('h1');
        if (h1Elements.length > 1) {
          console.warn('Multiple H1 tags detected on page. For optimal SEO, ensure only one H1 tag exists per page.');
        }
      }
    }

    customElements.define('seo-h1-section-{{ ai_gen_id }}', SeoH1Section{{ ai_gen_id }});
  })();
</script>

