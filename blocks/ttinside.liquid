{% doc %}
  @prompt
    Hey, we have testimonials in blogs and News and we have testimonials. Okay, so we want to show test just testimonials in a card a responsive card and Just card there there should be nothing in it. Just the titles and The description that have the card description that have okay Testimony wanna we want a popular just testimonials on the section Okay, so create a great section there where users can see just image title and The blog Text okay, nothing else. I don't want you to add any buttons or any Icon something like that. You have to create really amazing section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-section-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonials-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-testimonials-scroller-{{ ai_gen_id }} {
    overflow: hidden;
  }

  .ai-testimonials-grid-{{ ai_gen_id }} {
    display: flex;
    width: max-content;
  }

  .ai-testimonials-grid-{{ ai_gen_id }}.is-ready {
    {% if block.settings.enable_scroll_animation %}
      animation: scroll-{{ ai_gen_id }} {{ block.settings.animation_duration }}s linear infinite;
    {% endif %}
  }

  @keyframes scroll-{{ ai_gen_id }} {
    to {
      transform: translate(calc(-50% - {{ block.settings.card_spacing | divided_by: 2 }}px));
    }
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_spacing }}px;
    {% if block.settings.show_card_shadow %}
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    {% endif %}
    {% if block.settings.show_card_border %}
      border: 1px solid {{ block.settings.card_border_color }};
    {% endif %}
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    margin-right: {{ block.settings.card_spacing }}px;
    width: {{ block.settings.card_width }}px;
    flex-shrink: 0;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-testimonial-card-{{ ai_gen_id }}:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.12);
    }
  {% endif %}

  .ai-testimonial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-testimonial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-testimonial-rating-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    margin-bottom: 8px;
  }

  .ai-testimonial-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    font-weight: 600;
    line-height: 1.3;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.excerpt_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b {
    font-weight: 700;
  }

  .ai-testimonial-excerpt-{{ ai_gen_id }} strong em,
  .ai-testimonial-excerpt-{{ ai_gen_id }} strong i,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b em,
  .ai-testimonial-excerpt-{{ ai_gen_id }} b i,
  .ai-testimonial-excerpt-{{ ai_gen_id }} em strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} em b,
  .ai-testimonial-excerpt-{{ ai_gen_id }} i strong,
  .ai-testimonial-excerpt-{{ ai_gen_id }} i b {
    color: red;
    display: block;
    font-weight: 700;
    font-style: italic;
  }

  @media screen and (max-width: 989px) {

  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-section-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 0 {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-testimonials-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
      margin-bottom: {{ block.settings.heading_spacing | times: 0.7 }}px;
    }

    .ai-testimonial-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.8 }}px;
    }

    .ai-testimonial-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-testimonial-excerpt-{{ ai_gen_id }} {
      font-size: {{ block.settings.excerpt_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-testimonials-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-testimonials-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-testimonials-scroller-{{ ai_gen_id }}">
      <div class="ai-testimonials-grid-{{ ai_gen_id }}">
        {% if block.settings.blog != blank %}
          {% assign articles = block.settings.blog.articles %}
          {% assign article_limit = block.settings.articles_to_show %}
          
          {% for article in articles limit: article_limit %}
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                {% if article.image %}
                  <img
                    src="{{ article.image | image_url: width: 400 }}"
                    alt="{{ article.image.alt | escape }}"
                    loading="lazy"
                    width="400"
                    height="400"
                    class="ai-testimonial-image-{{ ai_gen_id }}"
                  >
                {% else %}
                  <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              <div class="ai-testimonial-content-{{ ai_gen_id }}">
                {% if block.settings.show_rating %}
                  <div class="ai-testimonial-rating-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.rating_value) %}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="#fdd835" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/>
                      </svg>
                    {% endfor %}
                  </div>
                {% endif %}
                {% if block.settings.show_title and article.title != blank %}
                  <h3 class="ai-testimonial-title-{{ ai_gen_id }}">{{ article.title }}</h3>
                {% endif %}

                {% if block.settings.show_excerpt %}
                  <div class="ai-testimonial-excerpt-{{ ai_gen_id }}">
                    {% if article.excerpt != blank %}
                      {{ article.excerpt }}
                    {% else %}
                      {{ article.content }}
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              <div class="ai-testimonial-image-wrapper-{{ ai_gen_id }}">
                <div class="ai-testimonial-image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              </div>

              <div class="ai-testimonial-content-{{ ai_gen_id }}">
                {% if block.settings.show_rating %}
                  <div class="ai-testimonial-rating-{{ ai_gen_id }}">
                    {% for i in (1..block.settings.rating_value) %}
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="#fdd835" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 17.27L18.18 21L16.54 13.97L22 9.24L14.81 8.63L12 2L9.19 8.63L2 9.24L7.46 13.97L5.82 21L12 17.27Z"/>
                      </svg>
                    {% endfor %}
                  </div>
                {% endif %}
                <h3 class="ai-testimonial-title-{{ ai_gen_id }}">Testimonial Title</h3>
                <div class="ai-testimonial-excerpt-{{ ai_gen_id }}">
                  <p>This is a sample testimonial text. Select a blog to display your testimonials.</p>
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <script>
      (function() {
        var grid = document.querySelector('.ai-testimonials-grid-{{ ai_gen_id }}');
        if (!grid) return;
        var cards = grid.querySelectorAll('.ai-testimonial-card-{{ ai_gen_id }}');
        if (!cards.length) return;
        var frag = document.createDocumentFragment();
        for (var i = 0; i < cards.length; i++) {
          var clone = cards[i].cloneNode(true);
          clone.setAttribute('aria-hidden', 'true');
          frag.appendChild(clone);
        }
        grid.appendChild(frag);
        grid.classList.add('is-ready');
      })();
    </script>
  </div>
</div>

{% schema %}
